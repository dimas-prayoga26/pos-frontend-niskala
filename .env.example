# Empty: API, uploads and realtime follow the current localhost/LAN address.
VITE_BACKEND_URL=
# Android app for Print Receipt: rawbt, or leave empty for Thermer.
VITE_ANDROID_PRINT_APP=rawbt
# Optional server-side proxy override; otherwise uses PORT from ../pos-backend/.env.
# API_PROXY_TARGET=http://127.0.0.1:8080
# For a deployment with a separate API, set VITE_BACKEND_URL=https://your-api-host.
